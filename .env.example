# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistock-db
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_AQUI

# ─── JWT (genera valores con: node -e "require('crypto').randomBytes(64).toString('hex')")
JWT_ACCESS_SECRET=GENERA_UN_SECRETO_ALEATORIO_LARGO
JWT_REFRESH_SECRET=GENERA_OTRO_SECRETO_ALEATORIO_LARGO
JWT_ACCESS_EXPIRY=15m

# ─── Wompi (sandbox — reemplaza por producción al desplegar) ──────────────────
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_EVENTS_SECRET=test_events_...

# ─── Email (Resend — obtén tu key en resend.com) ──────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=LogiStock <noreply@tudominio.com>
APP_URL=http://localhost:3000
